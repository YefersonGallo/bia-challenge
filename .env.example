# Copy to .env (never commit .env).

# HMAC secret for session tokens. Generate one with: openssl rand -hex 32
AUTH_SECRET=change-me

# Optional: enables explanations written by Claude. Without it the engine's
# deterministic templates are used (classification and figures are identical).
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-sonnet-5

# Demo login
DEMO_USER=operador@vatio.demo
DEMO_PASSWORD=demo

POSTGRES_PASSWORD=vatio
WEB_PORT=8080
# Pause between analysis steps so the progress is visible in the UI (ms).
STEP_DELAY_MS=450

# Production on a VPS (docker-compose.prod.yml): public hostname for HTTPS.
# DOMAIN=vatio.midominio.com   or   DOMAIN=203.0.113.10.sslip.io
